# Copy to .env (git-ignored) and adjust. All variables use the H3MAP_ prefix except connection secrets.
H3MAP_JWT_SECRET=change-me-to-a-long-random-string
H3MAP_ADMIN_USERNAME=admin
H3MAP_ADMIN_PASSWORD=change-me
# or a hash: python -c "from app.auth.jwt import hash_password; print(hash_password('pw'))"
# H3MAP_ADMIN_PASSWORD_HASH=
H3MAP_CORS_ORIGINS=["http://localhost:5173"]
H3MAP_CONNECTIONS_FILE=connections.yaml

# secret referenced by connections.yaml (password_env)
ANASTASIA_DB_PASSWORD=

# tests only: superuser DSN of the local server; tests create/drop a scratch database h3map_test
# H3MAP_TEST_ADMIN_DSN=postgresql://user:password@localhost:5432/postgres
